{
  "display_information": {
    "name": "DATAGOUV--AGENT",
    "description": "Agent de recherche et d'enrichissement de données entreprises (data.gouv, SIRENE, etc.)",
    "background_color": "#2c2d30"
  },
  "features": {
    "bot_user": {
      "display_name": "DATAGOUV--AGENT",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/datagouv",
        "description": "Rechercher des entreprises via data.gouv",
        "usage_hint": "[requête]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "chat:write.public",
        "commands",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "mpim:read",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
